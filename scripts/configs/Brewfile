# =============================================================================
# Homebrew Brewfile
# -----------------------------------------------------------------------------
# Purpose:
#   Local developer/bootstrap tooling for the Infrastructure repository.
#
# Used by:
#   scripts/initialize-repo.sh
#
# Install:
#   brew bundle --file=scripts/configs/Brewfile
#
# Notes:
#   - Keep this focused on workstation/controller tooling.
#   - Python dependencies belong in Ansible/requirements.txt.
#   - Ansible Galaxy dependencies belong in Ansible/requirements.yaml.
#   - Cluster/runtime packages belong in Ansible roles, not this Brewfile.
# =============================================================================

# =============================================================================
# Taps
# =============================================================================

tap "hashicorp/tap"
tap "go-task/tap"
tap "fluxcd/tap"

# =============================================================================
# Shell / Environment
# =============================================================================

brew "direnv"        # Directory-aware environment loading
brew "zsh"           # Shell used by local workstation setup
brew "starship"      # Cross-shell prompt

# =============================================================================
# Git / GitHub
# =============================================================================

brew "git"           # Version control
brew "gh"            # GitHub CLI

# =============================================================================
# Automation
# =============================================================================

brew "go-task"       # Task runner used by taskfile.yaml
brew "pre-commit"    # Local quality hooks

# =============================================================================
# Python Tooling
# =============================================================================

brew "python@3.12"   # Stable Python runtime for Ansible virtualenvs
brew "pipx"          # Isolated Python CLI package installer

# =============================================================================
# Infrastructure as Code
# =============================================================================

brew "hashicorp/tap/terraform" # Terraform IaC
brew "tflint"                  # Terraform linting
brew "terraform-docs"          # Terraform module documentation generator

# =============================================================================
# Secrets / Encryption
# =============================================================================

brew "sops"          # Encrypted YAML/JSON/env files
brew "age"           # Modern file encryption used by SOPS
brew "vault"         # HashiCorp Vault CLI

# =============================================================================
# Kubernetes / GitOps
# =============================================================================

brew "kubectl"       # Kubernetes CLI
brew "helm"          # Kubernetes package manager
brew "kustomize"     # Kustomize manifest tooling
brew "minikube"      # Local Kubernetes testing
brew "istioctl"      # Istio CLI
brew "fluxcd/tap/flux" # Flux GitOps CLI
brew "k9s"           # Terminal Kubernetes UI
brew "kubectx"       # Switch Kubernetes contexts/namespaces
brew "stern"         # Multi-pod Kubernetes logs

# =============================================================================
# Containers
# =============================================================================

brew "docker"        # Docker CLI
brew "docker-compose" # Docker Compose CLI

# =============================================================================
# Data / File Utilities
# =============================================================================

brew "jq"            # JSON processor
brew "yq"            # YAML/XML/TOML processor
brew "ripgrep"       # Fast search
brew "fd"            # Fast find alternative
brew "tree"          # Directory tree viewer
brew "coreutils"     # GNU core utilities
brew "gnu-sed"       # GNU sed
brew "grep"          # GNU grep
brew "wget"          # File downloader
brew "curl"          # HTTP client

# =============================================================================
# Networking / Diagnostics
# =============================================================================

brew "nmap"          # Network scanning
brew "ipcalc"        # CIDR/subnet calculations
brew "mtr"           # Network path diagnostics
brew "bind"          # dig/nslookup DNS tools
brew "openssl"       # TLS and certificate diagnostics

# =============================================================================
# Documentation
# =============================================================================

brew "mkdocs"        # Docs site local preview/build helper
brew "graphviz"      # Diagram rendering support