#cloud-config
# Ansible/templates/packer/http/user-data.j2
#
# Ubuntu autoinstall config for {{ vm_name }}.
#
# Rendered by Ansible into:
#   Packer/{{ distro }}/http/user-data
#
# Packer expects to SSH into the installed guest as:
#   username: {{ packer_ssh_username | default('packer') }}
#   password: {{ packer_ssh_password | default(preseed_root_password | default('packer')) }}
#
# This file must ensure:
#   - Ubuntu autoinstall runs non-interactively.
#   - openssh-server is installed.
#   - password SSH auth is temporarily enabled for Packer.
#   - the packer user exists and has sudo.
#   - qemu-guest-agent and cloud-init are installed for Proxmox clones.

autoinstall:
  version: 1

  locale: en_US.UTF-8

  keyboard:
    layout: us
    variant: ""

  timezone: UTC

  interactive-sections: []

  refresh-installer:
    update: false

  apt:
    preserve_sources_list: false
    primary:
      - arches:
          - amd64
        uri: "http://{{ preseed_mirror_host | default('archive.ubuntu.com') }}{{ preseed_mirror_directory | default('/ubuntu') }}"
      - arches:
          - default
        uri: "http://archive.ubuntu.com/ubuntu"

  network:
    network:
      version: 2
      ethernets:
        all-en:
          match:
            name: "en*"
          dhcp4: true
          dhcp6: false
        all-eth:
          match:
            name: "eth*"
          dhcp4: true
          dhcp6: false

  storage:
    layout:
      name: direct

  identity:
    hostname: "{{ preseed_hostname }}"
    username: "{{ packer_ssh_username | default('packer') }}"
    realname: "Packer Template User"

    # Autoinstall requires this to be a hashed password.
    #
    # Default password source:
    #   packer_ssh_password -> preseed_root_password -> packer
    #
    # To override with a precomputed hash, define:
    #   autoinstall_user_password_hash
    password: "{{ autoinstall_user_password_hash | default((packer_ssh_password | default(preseed_root_password | default('packer'))) | password_hash('sha512', 'packer')) }}"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  packages:
    - apt-transport-https
    - bash-completion
    - build-essential
    - ca-certificates
    - cloud-guest-utils
    - cloud-init
    - cloud-initramfs-growroot
    - curl
    - dbus
    - gnupg
    - jq
    - less
    - lsb-release
    - net-tools
    - openssh-server
    - qemu-guest-agent
    - rsync
    - sudo
    - unzip
    - vim
    - wget

  user-data:
    disable_root: false
    package_update: false
    package_upgrade: false
    timezone: UTC

    chpasswd:
      expire: false
      users:
        - name: root
          password: "{{ packer_ssh_password | default(preseed_root_password | default('packer')) }}"
          type: text
        - name: "{{ packer_ssh_username | default('packer') }}"
          password: "{{ packer_ssh_password | default(preseed_root_password | default('packer')) }}"
          type: text

    users:
      - default
      - name: "{{ packer_ssh_username | default('packer') }}"
        gecos: Packer Template User
        groups:
          - adm
          - cdrom
          - dip
          - lxd
          - plugdev
          - sudo
        shell: /bin/bash
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        lock_passwd: false

  late-commands:
    # Ensure the packer user exists, has sudo, and can authenticate before
    # Packer starts waiting for SSH.
    - curtin in-target --target=/target -- id "{{ packer_ssh_username | default('packer') }}" || curtin in-target --target=/target -- useradd -m -s /bin/bash "{{ packer_ssh_username | default('packer') }}"
    - curtin in-target --target=/target -- usermod -aG sudo "{{ packer_ssh_username | default('packer') }}"
    - curtin in-target --target=/target -- sh -c "printf '%s:%s\n' '{{ packer_ssh_username | default('packer') }}' '{{ packer_ssh_password | default(preseed_root_password | default('packer')) }}' | chpasswd"
    - curtin in-target --target=/target -- sh -c "printf '%s:%s\n' 'root' '{{ packer_ssh_password | default(preseed_root_password | default('packer')) }}' | chpasswd"

    # Keep SSH permissive only for the Packer build phase.
    # Your cleanup/hardening automation can replace this later for deployed VMs.
    - curtin in-target --target=/target -- mkdir -p /etc/ssh/sshd_config.d
    - curtin in-target --target=/target -- sh -c "printf '%s\n' 'PermitRootLogin yes' 'PasswordAuthentication yes' 'PubkeyAuthentication yes' 'KbdInteractiveAuthentication no' > /etc/ssh/sshd_config.d/99-packer.conf"
    - curtin in-target --target=/target -- systemctl enable ssh.service
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent.service || true

    # Proxmox cloud-init datasource preference.
    - curtin in-target --target=/target -- mkdir -p /etc/cloud/cloud.cfg.d
    - curtin in-target --target=/target -- sh -c "printf '%s\n' 'datasource_list: [ NoCloud, ConfigDrive ]' > /etc/cloud/cloud.cfg.d/99-packer-proxmox.cfg"

    # Avoid cloud-init fighting the DHCP config used during install.
    - curtin in-target --target=/target -- sh -c "printf '%s\n' 'network:' '  config: disabled' > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg"

    # Improve console visibility in Proxmox.
    - curtin in-target --target=/target -- sh -c "sed -i 's/^GRUB_CMDLINE_LINUX=.*/GRUB_CMDLINE_LINUX=\"console=tty0 console=ttyS0,115200n8\"/' /etc/default/grub"
    - curtin in-target --target=/target -- update-grub

    # Clean cloud-init state so clones initialize cleanly.
    - curtin in-target --target=/target -- cloud-init clean --logs --seed || true

  shutdown: reboot
