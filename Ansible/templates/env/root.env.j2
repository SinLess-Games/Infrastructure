# =============================================================================
# Local runtime secrets for Infrastructure
# -----------------------------------------------------------------------------
# Ansible/templates/env/root.env.j2
#
# Purpose:
#   Local-only secret environment variables used by Terraform, Ansible, Packer,
#   Proxmox automation, and bootstrap tooling.
#
# Rules:
#   - Secrets only.
#   - Do not put non-secret config here.
#   - Do not commit rendered output.
#   - Rendered file should stay gitignored.
#   - Prefer Vault / External Secrets / sealed secret flows later.
#
# Current phase:
#   - HashiCorp Vault is not deployed yet.
#   - Ansible Vault is not enabled yet.
#   - Do not export VAULT_* or ANSIBLE_VAULT_* variables here.
#
# Recommended rendered path:
#   .env
#   .env.local
#   .outputs/env/root.env
#
# Recommended permissions:
#   chmod 0600 <rendered-file>
# =============================================================================

{% macro export_secret(name) -%}
export {{ name }}={{ lookup('env', name) | default('', true) | quote }}
{%- endmacro %}

# -----------------------------------------------------------------------------
# Terraform / Proxmox
# -----------------------------------------------------------------------------
# Used by Terraform providers and Proxmox automation.
# Token format generally follows:
#   TF_VAR_proxmox_api_token_id="user@realm!token-name"
#   TF_VAR_proxmox_api_token_secret="token-secret"

{{ export_secret('TF_VAR_proxmox_api_token_id') }}
{{ export_secret('TF_VAR_proxmox_api_token_secret') }}

# Optional Proxmox provider aliases used by some tools/providers.
{{ export_secret('PROXMOX_VE_API_TOKEN') }}
{{ export_secret('PROXMOX_API_TOKEN_ID') }}
{{ export_secret('PROXMOX_API_TOKEN_SECRET') }}

# SSH/password bootstrap fallback.
# Prefer SSH keys/certs and API tokens where possible.
{{ export_secret('PROXMOX_SSH_PASSWORD') }}
{{ export_secret('PROXMOX_CLUSTER_JOIN_PASSWORD') }}

# -----------------------------------------------------------------------------
# Packer / Proxmox template builds
# -----------------------------------------------------------------------------
# Packer should usually read the generated token file:
#   .outputs/api-tokens/packer-prov-api-token.txt
#
# These are available as runtime overrides when needed.

{{ export_secret('PKR_VAR_proxmox_api_token_id') }}
{{ export_secret('PKR_VAR_proxmox_api_token_secret') }}

# -----------------------------------------------------------------------------
# Ansible
# -----------------------------------------------------------------------------
# Used only when password-based privilege escalation is required.
# Prefer SSH keys/certs and passwordless sudo for controlled local bootstrap.
#
# Ansible Vault is intentionally not exported during this phase.

{{ export_secret('ANSIBLE_BECOME_PASSWORD') }}
