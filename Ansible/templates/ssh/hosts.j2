# =============================================================================
# /etc/hosts managed by Ansible
# -----------------------------------------------------------------------------
# Purpose:
#   Provides stable local hostname resolution for managed infrastructure hosts.
#
# Notes:
#   - Do not edit manually; changes will be overwritten by Ansible.
#   - Canonical local DNS zone: local.sinlessgames.com
#   - Public/internal DNS should still be handled by Technitium.
#   - This file is only a local fallback for bootstrap, SSH, and recovery.
# =============================================================================

# -----------------------------------------------------------------------------
# Localhost
# -----------------------------------------------------------------------------

127.0.0.1 localhost.localdomain localhost
127.0.1.1 {{ ansible_hostname | default(inventory_hostname) }}.{{ ssh_primary_local_domain | default('local.sinlessgames.com') }} {{ ansible_hostname | default(inventory_hostname) }}

# -----------------------------------------------------------------------------
# IPv6 localhost / multicast
# -----------------------------------------------------------------------------

::1       localhost ip6-localhost ip6-loopback
fe00::0   ip6-localnet
ff00::0   ip6-mcastprefix
ff02::1   ip6-allnodes
ff02::2   ip6-allrouters
ff02::3   ip6-allhosts

# -----------------------------------------------------------------------------
# Managed infrastructure hosts
# -----------------------------------------------------------------------------
# Entries are generated from inventory and gathered facts.
# Preference order for IPv4:
#   1. hostvars[host].ansible_host
#   2. hostvars[host].ansible_default_ipv4.address
#   3. hostvars[host].ip
#
# Generated aliases:
#   - inventory hostname
#   - discovered short hostname
#   - discovered FQDN
#   - <inventory>.local.sinlessgames.com
#   - <short>.local.sinlessgames.com
# -----------------------------------------------------------------------------

{% set local_domain = ssh_primary_local_domain | default('local.sinlessgames.com') %}
{% set local_zones = ssh_local_dns_zones | default([local_domain]) %}
{% set rendered_entries = [] %}

{% for host in groups['all'] | default([]) | sort %}
{% set hv = hostvars[host] %}
{% set ipv4 = hv.ansible_host | default(hv.ansible_default_ipv4.address | default(hv.ip | default(''))) %}
{% set short_name = hv.ansible_hostname | default(host) %}
{% set fqdn = hv.ansible_fqdn | default(short_name ~ '.' ~ local_domain) %}

{% if ipv4 | length > 0 %}
{% set aliases = [] %}
{% set _ = aliases.append(host) %}
{% if short_name != host %}
{% set _ = aliases.append(short_name) %}
{% endif %}
{% if fqdn not in aliases %}
{% set _ = aliases.append(fqdn) %}
{% endif %}

{% for zone in local_zones %}
{% set inventory_fqdn = host ~ '.' ~ zone %}
{% set short_fqdn = short_name ~ '.' ~ zone %}
{% if inventory_fqdn not in aliases %}
{% set _ = aliases.append(inventory_fqdn) %}
{% endif %}
{% if short_fqdn not in aliases %}
{% set _ = aliases.append(short_fqdn) %}
{% endif %}
{% endfor %}

{% set entry = ipv4 ~ ' ' ~ (aliases | unique | join(' ')) %}
{% if entry not in rendered_entries %}
{% set _ = rendered_entries.append(entry) %}
{{ entry }}
{% endif %}
{% endif %}
{% endfor %}

# -----------------------------------------------------------------------------
# Optional static host entries
# -----------------------------------------------------------------------------
# Define ssh.hosts.extra_lines as a list of literal /etc/hosts lines when needed.
# Example:
#   ssh:
#     hosts:
#       extra_lines:
#         - "10.10.10.1 gateway.local.sinlessgames.com gateway"
# -----------------------------------------------------------------------------

{% for line in ssh.hosts.extra_lines | default([]) %}
{{ line }}
{% endfor %}

# =============================================================================
# End managed /etc/hosts
# =============================================================================
