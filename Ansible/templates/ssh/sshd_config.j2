# =============================================================================
# OpenSSH Server Configuration - Ansible Managed
# -----------------------------------------------------------------------------
# Intended deployment:
#   /etc/ssh/sshd_config.d/*.conf
#
# Purpose:
#   Harden OpenSSH while preserving safe automation access for Proxmox,
#   Ansible, Packer, and CA-backed SSH certificate authentication.
#
# Security model:
#   - Public key authentication remains enabled by default.
#   - SSH user certificates are enabled through TrustedUserCAKeys.
#   - AuthorizedPrincipalsFile maps certificate principals to local users.
#   - Password and keyboard-interactive authentication are disabled by default.
#   - Root login is allowed by public key/certificate only by default.
#   - Host certificates are optional and enabled only when configured.
#
# Safety:
#   - Do not set MaxAuthTries too low. SSH agents may offer several keys before
#     the correct key/certificate is attempted.
#   - This drop-in should not remove distro defaults unless explicitly set.
#   - Avoid duplicate Subsystem directives unless intentionally overriding SFTP.
#
# Do not edit manually. Changes will be overwritten by Ansible.
# =============================================================================

{% set ssh_cfg = ssh | default({}) %}
{% set ssh_server = ssh_cfg.server | default({}) %}

{% macro yesno(value) -%}
{{ 'yes' if value | bool else 'no' }}
{%- endmacro %}

{% macro forwarding(value, default_value='no') -%}
{%- if value is boolean -%}
{{ 'yes' if value else 'no' }}
{%- else -%}
{{ value | default(default_value) }}
{%- endif -%}
{%- endmacro %}

# -----------------------------------------------------------------------------
# Listener / basics
# -----------------------------------------------------------------------------

{% if ssh_server.ports is defined and ssh_server.ports | length > 0 %}
{% for port in ssh_server.ports %}
Port {{ port }}
{% endfor %}
{% elif ssh_server.port is defined %}
Port {{ ssh_server.port }}
{% else %}
Port 22
{% endif %}

AddressFamily {{ ssh_server.address_family | default('any') }}

{% if ssh_server.listen_addresses is defined and ssh_server.listen_addresses | length > 0 %}
{% for address in ssh_server.listen_addresses %}
ListenAddress {{ address }}
{% endfor %}
{% endif %}

{% if ssh_server.host_keys is defined and ssh_server.host_keys | length > 0 %}
{% for host_key in ssh_server.host_keys %}
HostKey {{ host_key }}
{% endfor %}
{% endif %}

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

UsePAM {{ yesno(ssh_server.use_pam | default(true)) }}

# Required for regular public-key auth and SSH user certificate auth.
PubkeyAuthentication {{ yesno(ssh_server.pubkey_authentication | default(true)) }}

# Infrastructure access should use SSH keys or SSH certificates.
PasswordAuthentication {{ yesno(ssh_server.password_authentication | default(false)) }}
PermitEmptyPasswords {{ yesno(ssh_server.permit_empty_passwords | default(false)) }}

# OpenSSH has used both names across versions/configs. Keep both explicit for
# cross-distro behavior.
KbdInteractiveAuthentication {{ yesno(ssh_server.kbd_interactive_authentication | default(false)) }}
KeyboardInteractiveAuthentication {{ yesno(ssh_server.keyboard_interactive_authentication | default(ssh_server.kbd_interactive_authentication | default(false))) }}
ChallengeResponseAuthentication {{ yesno(ssh_server.challenge_response_authentication | default(false)) }}

# Disable legacy trust-based auth paths unless explicitly enabled.
HostbasedAuthentication {{ yesno(ssh_server.hostbased_authentication | default(false)) }}
IgnoreRhosts {{ yesno(ssh_server.ignore_rhosts | default(true)) }}

# Default permits root login only by public key/certificate, not password.
PermitRootLogin {{ ssh_server.permit_root_login | default('prohibit-password') }}

{% if ssh_server.authentication_methods is defined and ssh_server.authentication_methods | length > 0 %}
AuthenticationMethods {{ ssh_server.authentication_methods }}
{% endif %}

AuthorizedKeysFile {{ ssh_server.authorized_keys_file | default('.ssh/authorized_keys .ssh/authorized_keys2') }}

{% if ssh_server.pubkey_accepted_algorithms is defined and ssh_server.pubkey_accepted_algorithms | length > 0 %}
PubkeyAcceptedAlgorithms {{ ssh_server.pubkey_accepted_algorithms }}
{% endif %}

{% if ssh_server.hostbased_accepted_algorithms is defined and ssh_server.hostbased_accepted_algorithms | length > 0 %}
HostbasedAcceptedAlgorithms {{ ssh_server.hostbased_accepted_algorithms }}
{% endif %}

{% if ssh_server.banner_enabled | default(false) %}
Banner {{ ssh_server.banner_path | default('/etc/issue.net') }}
{% endif %}

# -----------------------------------------------------------------------------
# SSH Certificate Authentication - User CA
# -----------------------------------------------------------------------------
# TrustedUserCAKeys enables SSH user certificate authentication.
# AuthorizedPrincipalsFile controls which certificate principals may authenticate
# as each local Unix account.
# -----------------------------------------------------------------------------

TrustedUserCAKeys {{ ssh_server.trusted_user_ca_keys | default('/etc/ssh/ca/ssh_ca.pub') }}
AuthorizedPrincipalsFile {{ ssh_server.authorized_principals_file | default('/etc/ssh/auth_principals/%u') }}

# -----------------------------------------------------------------------------
# Host Certificate - Server Identity
# -----------------------------------------------------------------------------

{% if ssh_server.enable_host_certificate | default(false) %}
HostCertificate {{ ssh_server.host_certificate_path | default('/etc/ssh/ssh_host_ed25519_key-cert.pub') }}
{% endif %}

# -----------------------------------------------------------------------------
# Access Control
# -----------------------------------------------------------------------------
# Be careful with AllowUsers / AllowGroups on Proxmox nodes. If root is used for
# automation, root must be included when allow-lists are configured.
# -----------------------------------------------------------------------------

{% if ssh_server.allow_users is defined and ssh_server.allow_users | length > 0 %}
AllowUsers {{ ssh_server.allow_users | join(' ') }}
{% endif %}

{% if ssh_server.allow_groups is defined and ssh_server.allow_groups | length > 0 %}
AllowGroups {{ ssh_server.allow_groups | join(' ') }}
{% endif %}

{% if ssh_server.deny_users is defined and ssh_server.deny_users | length > 0 %}
DenyUsers {{ ssh_server.deny_users | join(' ') }}
{% endif %}

{% if ssh_server.deny_groups is defined and ssh_server.deny_groups | length > 0 %}
DenyGroups {{ ssh_server.deny_groups | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Session / Forwarding Controls
# -----------------------------------------------------------------------------

X11Forwarding {{ yesno(ssh_server.x11_forwarding | default(false)) }}
AllowAgentForwarding {{ yesno(ssh_server.allow_agent_forwarding | default(false)) }}
AllowTcpForwarding {{ forwarding(ssh_server.allow_tcp_forwarding | default('no')) }}
GatewayPorts {{ forwarding(ssh_server.gateway_ports | default('no')) }}
PermitTunnel {{ ssh_server.permit_tunnel | default('no') }}

PermitUserEnvironment {{ yesno(ssh_server.permit_user_environment | default(false)) }}
PermitUserRC {{ yesno(ssh_server.permit_user_rc | default(true)) }}
PermitTTY {{ yesno(ssh_server.permit_tty | default(true)) }}

{% if ssh_server.compression is defined %}
Compression {{ ssh_server.compression }}
{% endif %}

# -----------------------------------------------------------------------------
# Hardening / Hygiene
# -----------------------------------------------------------------------------

UseDNS {{ yesno(ssh_server.use_dns | default(false)) }}
TCPKeepAlive {{ yesno(ssh_server.tcp_keep_alive | default(ssh_server.tcp_keepalive | default(true))) }}

LoginGraceTime {{ ssh_server.login_grace_time | default(30) }}

# Keep this high enough to avoid lockouts when ssh-agent offers multiple keys.
MaxAuthTries {{ ssh_server.max_auth_tries | default(10) }}

MaxSessions {{ ssh_server.max_sessions | default(10) }}
MaxStartups {{ ssh_server.max_startups | default('10:30:60') }}

ClientAliveInterval {{ ssh_server.client_alive_interval | default(300) }}
ClientAliveCountMax {{ ssh_server.client_alive_count_max | default(2) }}

LogLevel {{ ssh_server.log_level | default('VERBOSE') }}
{% if ssh_server.syslog_facility is defined %}
SyslogFacility {{ ssh_server.syslog_facility }}
{% endif %}

PrintMotd {{ yesno(ssh_server.print_motd | default(false)) }}
PrintLastLog {{ yesno(ssh_server.print_last_log | default(true)) }}

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------

{% if ssh_server.accept_env is defined and ssh_server.accept_env | length > 0 %}
AcceptEnv {{ ssh_server.accept_env | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Crypto Policy
# -----------------------------------------------------------------------------
# Only set these when intentionally overriding the distro crypto policy.
# -----------------------------------------------------------------------------

{% if ssh_server.ciphers is defined and ssh_server.ciphers | length > 0 %}
Ciphers {{ ssh_server.ciphers | join(',') }}
{% endif %}

{% if ssh_server.macs is defined and ssh_server.macs | length > 0 %}
MACs {{ ssh_server.macs | join(',') }}
{% endif %}

{% if ssh_server.kex_algorithms is defined and ssh_server.kex_algorithms | length > 0 %}
KexAlgorithms {{ ssh_server.kex_algorithms | join(',') }}
{% endif %}

{% if ssh_server.host_key_algorithms is defined and ssh_server.host_key_algorithms | length > 0 %}
HostKeyAlgorithms {{ ssh_server.host_key_algorithms | join(',') }}
{% endif %}

{% if ssh_server.casignature_algorithms is defined and ssh_server.casignature_algorithms | length > 0 %}
CASignatureAlgorithms {{ ssh_server.casignature_algorithms | join(',') }}
{% endif %}

# -----------------------------------------------------------------------------
# SFTP Subsystem
# -----------------------------------------------------------------------------
# By default, omit Subsystem here and keep the distro's main sshd_config value.
# Set ssh.server.sftp_subsystem_override=true only when you intentionally want
# this drop-in to own the SFTP subsystem line.
# -----------------------------------------------------------------------------

{% if ssh_server.sftp_subsystem_override | default(false) %}
Subsystem sftp {{ ssh_server.sftp_subsystem | default('internal-sftp') }}
{% endif %}

# -----------------------------------------------------------------------------
# Optional root hardening override
# -----------------------------------------------------------------------------
# Keeps root public-key/certificate only even if global password auth is later
# enabled for a temporary recovery workflow.
# -----------------------------------------------------------------------------

{% if ssh_server.root_pubkey_only | default(true) %}
Match User root
  AuthenticationMethods publickey
  PubkeyAuthentication yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  KeyboardInteractiveAuthentication no
  ChallengeResponseAuthentication no
{% endif %}

# -----------------------------------------------------------------------------
# Optional Packer ISO upload user override
# -----------------------------------------------------------------------------
# If ISO uploads move away from root, set:
#
#   ssh:
#     server:
#       packer_upload_user: packer-upload
#
# Then create that user and grant only the required storage-write permissions.
# -----------------------------------------------------------------------------

{% if ssh_server.packer_upload_user is defined and ssh_server.packer_upload_user | length > 0 %}
Match User {{ ssh_server.packer_upload_user }}
  AuthenticationMethods publickey
  PubkeyAuthentication yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  KeyboardInteractiveAuthentication no
  ChallengeResponseAuthentication no
  X11Forwarding no
  AllowAgentForwarding no
  AllowTcpForwarding no
  PermitTunnel no
  PermitTTY yes
{% endif %}

# =============================================================================
# End managed OpenSSH server configuration
# =============================================================================
