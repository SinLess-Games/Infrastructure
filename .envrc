# =============================================================================
# Direnv configuration for Infrastructure
# -----------------------------------------------------------------------------
# Purpose:
#   Configures repo-local tooling when entering this directory.
#
# Owns:
#   - Python virtualenv activation
#   - Ansible config discovery
#   - Vault environment defaults
#   - Kubernetes kubeconfig defaults
#   - Terraform runtime defaults
#
# Does not duplicate settings already owned by:
#   - Ansible/ansible.cfg
#   - Ansible/group_vars/*
#   - Terraform variable files
# =============================================================================

# -----------------------------------------------------------------------------
# Repo paths
# -----------------------------------------------------------------------------

export INFRA_REPO_ROOT="$PWD"
export ANSIBLE_ROOT="$INFRA_REPO_ROOT/Ansible"
export OUTPUTS_DIR="$INFRA_REPO_ROOT/.outputs"

# -----------------------------------------------------------------------------
# Local overrides / secrets
# -----------------------------------------------------------------------------
# Keep .env out of git. Use it for machine-local values only.

source_env_if_exists .env

# -----------------------------------------------------------------------------
# Python / virtualenv
# -----------------------------------------------------------------------------

export VIRTUAL_ENV="$ANSIBLE_ROOT/.venv"

if [[ -d "$VIRTUAL_ENV" ]]; then
  PATH_add "$VIRTUAL_ENV/bin"
fi

PATH_add "$HOME/.local/bin"

# -----------------------------------------------------------------------------
# Ansible
# -----------------------------------------------------------------------------
# Keep only the repo anchor here.
# Inventory, roles_path, collections_path, callbacks, host key behavior, facts,
# and SSH settings are owned by Ansible/ansible.cfg.

export ANSIBLE_CONFIG="$ANSIBLE_ROOT/ansible.cfg"

# Repo-local runtime dirs used by ansible.cfg.
mkdir -p \
  "$ANSIBLE_ROOT/.ansible/tmp" \
  "$ANSIBLE_ROOT/.ansible/facts" \
  "$ANSIBLE_ROOT/.ansible/cp" \
  "$ANSIBLE_ROOT/.collections" \
  "$OUTPUTS_DIR"

# -----------------------------------------------------------------------------
# Vault
# -----------------------------------------------------------------------------

export VAULT_ADDR="${VAULT_ADDR:-https://10.10.10.180:443}"

if [[ -f "$OUTPUTS_DIR/vault/vault-ca.pem" ]]; then
  export VAULT_CACERT="$OUTPUTS_DIR/vault/vault-ca.pem"
  unset VAULT_SKIP_VERIFY
else
  export VAULT_SKIP_VERIFY="${VAULT_SKIP_VERIFY:-true}"
fi

if [[ -z "${VAULT_TOKEN:-}" && -f "$OUTPUTS_DIR/vault/unseal-keys.json" ]] && command -v jq >/dev/null 2>&1; then
  export VAULT_TOKEN="$(jq -r '.root_token // empty' "$OUTPUTS_DIR/vault/unseal-keys.json" 2>/dev/null || true)"
fi

if [[ -n "${VAULT_TOKEN:-}" && -z "${TF_HTTP_PASSWORD:-}" ]]; then
  export TF_HTTP_PASSWORD="$VAULT_TOKEN"
fi

# -----------------------------------------------------------------------------
# PXE / local infrastructure defaults
# -----------------------------------------------------------------------------

export DOMAIN="${DOMAIN:-sinlessgames.com}"
export LOCAL_DOMAIN="${LOCAL_DOMAIN:-local.sinlessgames.com}"

export PXE_HTTP_HOST="${PXE_HTTP_HOST:-pxe.local.sinlessgames.com}"
export PXE_SERVER_IP="${PXE_SERVER_IP:-10.10.10.10}"

# -----------------------------------------------------------------------------
# Kubernetes
# -----------------------------------------------------------------------------

if [[ -z "${KUBECONFIG:-}" && -f "$OUTPUTS_DIR/kubernetes/prod/kubeconfig" ]]; then
  export KUBECONFIG="$OUTPUTS_DIR/kubernetes/prod/kubeconfig"
fi

# -----------------------------------------------------------------------------
# Terraform / deployment controls
# -----------------------------------------------------------------------------

export TF_IN_AUTOMATION="${TF_IN_AUTOMATION:-0}"
export TF_PARALLELISM="${TF_PARALLELISM:-3}"
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-$HOME/.terraform.d/plugin-cache}"

mkdir -p "$TF_PLUGIN_CACHE_DIR"

export KUBERNETES_CONFIGURE_SERIAL="${KUBERNETES_CONFIGURE_SERIAL:-3}"
export KUBERNETES_TERRAFORM_LOCK_TIMEOUT="${KUBERNETES_TERRAFORM_LOCK_TIMEOUT:-10m}"

# -----------------------------------------------------------------------------
# Optional local debug
# -----------------------------------------------------------------------------
# Enable per-shell with:
#   export DEBUG=1
#
# Do not force DEBUG globally from .envrc.
# -----------------------------------------------------------------------------