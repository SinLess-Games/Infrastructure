{
  "chat.tools.terminal.autoApprove": {
    "task": true
  },
  "files.associations": {
    "mkdocs.yml": "yaml",
    "mkdocs.yaml": "yaml",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "*.tf": "terraform",
    "*.tfvars": "terraform",
    "*.pkr.hcl": "hcl",
    "*.pkrvars.hcl": "hcl",
    "Brewfile": "ruby",
    ".envrc": "shellscript"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.terraform": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "Ansible/.venv": true,
    "Ansible/.ansible": true,
    "Ansible/.collections": true,
    ".outputs": false
  },
  "search.exclude": {
    "**/.terraform": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "Ansible/.venv": true,
    "Ansible/.ansible": true,
    "Ansible/.collections": true,
    ".outputs": false,
    "site": true
  },
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [
    80,
    100,
    120
  ],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "yaml.validate": true,
  "yaml.format.enable": true,
  "yaml.hover": true,
  "yaml.completion": true,
  "yaml.schemaStore.enable": true,
  "yaml.maxItemsComputed": 10000,
  "yaml.schemas": {
    "https://squidfunk.github.io/mkdocs-material/schema.json": [
      "mkdocs.yml",
      "mkdocs.yaml"
    ],
    "https://json.schemastore.org/github-workflow.json": [
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ],
    "https://json.schemastore.org/github-action.json": [
      ".github/actions/*/action.yml",
      ".github/actions/*/action.yaml"
    ],
    "https://json.schemastore.org/docker-compose.json": [
      "docker-compose.yml",
      "docker-compose.yaml",
      "**/docker-compose.yml",
      "**/docker-compose.yaml"
    ],
    "https://json.schemastore.org/kustomization.json": [
      "**/kustomization.yml",
      "**/kustomization.yaml"
    ],
    "https://json.schemastore.org/ansible-playbook.json": [
      "Ansible/playbooks/*.yml",
      "Ansible/playbooks/*.yaml"
    ],
    "https://json.schemastore.org/ansible-vars.json": [
      "Ansible/group_vars/**/*.yml",
      "Ansible/group_vars/**/*.yaml",
      "Ansible/host_vars/**/*.yml",
      "Ansible/host_vars/**/*.yaml",
      "Ansible/roles/**/defaults/*.yml",
      "Ansible/roles/**/defaults/*.yaml",
      "Ansible/roles/**/vars/*.yml",
      "Ansible/roles/**/vars/*.yaml"
    ],
    "https://json.schemastore.org/ansible-tasks.json": [
      "Ansible/roles/**/tasks/*.yml",
      "Ansible/roles/**/tasks/*.yaml",
      "Ansible/roles/**/handlers/*.yml",
      "Ansible/roles/**/handlers/*.yaml"
    ],
    "https://json.schemastore.org/ansible-galaxy.json": [
      "Ansible/requirements.yml",
      "Ansible/requirements.yaml",
      "**/galaxy.yml",
      "**/galaxy.yaml"
    ]
  },
  "yaml.customTags": [
    "!ENV scalar",
    "!ENV sequence",
    "!relative scalar",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
    "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
  ],
  "ansible.python.interpreterPath": "${workspaceFolder}/Ansible/.venv/bin/python",
  "ansible.ansible.path": "${workspaceFolder}/Ansible/.venv/bin/ansible",
  "ansible.ansibleLint.path": "${workspaceFolder}/Ansible/.venv/bin/ansible-lint",
  "ansible.validation.enabled": true,
  "ansible.validation.lint.enabled": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/Ansible/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.typeCheckingMode": "basic",
  "terraform.languageServer.enable": true,
  "terraform.languageServer.path": "terraform-ls",
  "terraform.format.enable": true,
  "markdownlint.config": {
    "MD013": false,
    "MD024": false,
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": {
      "allowed_elements": [
        "a",
        "br",
        "details",
        "div",
        "img",
        "kbd",
        "p",
        "span",
        "summary"
      ]
    },
    "MD046": {
      "style": "fenced"
    }
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": false,
      "strings": false,
      "other": true
    }
  },
  "[shellscript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "ANSIBLE_CONFIG": "${workspaceFolder}/Ansible/ansible.cfg"
  },
  "git.autofetch": true,
  "git.confirmSync": false
}
